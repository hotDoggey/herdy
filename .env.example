# Mapbox secret downloads token — used only at native build time to pull the
# Mapbox SDK binary via CocoaPods. Get it from your Mapbox account's "Secret tokens".
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=

# Mapbox public token — safe to ship in the app bundle, used at runtime.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Firebase Web app config — from Firebase Console > Project settings > Your apps.
# These are not secrets (Firestore access is controlled by firestore.rules,
# not by hiding these values) but are still per-project.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
